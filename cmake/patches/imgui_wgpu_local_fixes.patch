+// Local patch, mirrors the DrawCallback_SetSamplerLinear/DrawCallback_SetSamplerNearest mechanism that
+// landed upstream in Dear ImGui v1.92.7 (ocornut/imgui#9378) - not available to us yet, see
+// IMGUI_IMPL_WGPU_HAS_SAMPLER_SWITCH in the header for why. Register one of these with
+// ImDrawList::AddCallback() to switch which sampler bind group 0 uses for subsequent draw commands in the
+// same render pass - e.g. to render a nearest-filtered preview image among otherwise-linear-filtered UI.
+// Always pair a SetSamplerNearest call with a matching SetSamplerLinear call right after, since the bound
+// group persists across draw commands until changed again.
+void ImGui_ImplWGPU_DrawCallback_SetSamplerLinear(const ImDrawList*, const ImDrawCmd*)
+{
+    ImGui_ImplWGPU_Data* bd = ImGui_ImplWGPU_GetBackendData();
+    ImGui_ImplWGPU_RenderState* render_state = (ImGui_ImplWGPU_RenderState*)ImGui::GetPlatformIO().Renderer_RenderState;
+    wgpuRenderPassEncoderSetBindGroup(render_state->RenderPassEncoder, 0, bd->renderResources.CommonBindGroupLinear, 0, nullptr);
+}
+
+void ImGui_ImplWGPU_DrawCallback_SetSamplerNearest(const ImDrawList*, const ImDrawCmd*)
+{
+    ImGui_ImplWGPU_Data* bd = ImGui_ImplWGPU_GetBackendData();
+    ImGui_ImplWGPU_RenderState* render_state = (ImGui_ImplWGPU_RenderState*)ImGui::GetPlatformIO().Renderer_RenderState;
+    wgpuRenderPassEncoderSetBindGroup(render_state->RenderPassEncoder, 0, bd->renderResources.CommonBindGroupNearest, 0, nullptr);
+}
