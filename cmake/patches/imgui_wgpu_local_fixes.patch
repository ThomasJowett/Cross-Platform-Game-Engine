+// Releases cached per-texture bind groups (keyed by texture view pointer) without touching
+// the font atlas/pipeline. Call this after destroying any WGPUTextureView that may have been
+// shown via ImGui::Image() - otherwise a later texture view allocated at the same address
+// (e.g. after a resize destroys and recreates a render target) can be handed a stale, already-
+// invalid bind group left over from the destroyed one, since this cache is never otherwise
+// invalidated per-entry.
+//
+// NOTE: this is a local patch, not upstream Dear ImGui. The proper fix landed upstream in
+// v1.91.9 ("Recreate image bind groups during render", #8426/#8046/#7765/#8027), but that
+// commit also bundles a WebGPU-native header update (WGPUTexelCopyTextureInfo, WGPU_STRLEN,
+// etc.) our vendored wgpu-native distribution doesn't provide yet - upgrading imgui alone
+// doesn't compile. Revert this patch and bump the Engine/vendor/imgui submodule to
+// v1.91.9-docking (or later) instead, once the WebGPU-native dependency is upgraded to match.
+//
+// This header is a local, uncommitted patch (the committed imgui submodule pointer doesn't have
+// it) - callers must guard use of this function behind #ifdef IMGUI_IMPL_WGPU_HAS_INVALIDATE_IMAGE_BIND_GROUPS
+// so committed code still compiles against the real, unpatched submodule (CI, fresh clones).
+#define IMGUI_IMPL_WGPU_HAS_INVALIDATE_IMAGE_BIND_GROUPS 1
+IMGUI_IMPL_API void ImGui_ImplWGPU_InvalidateImageBindGroups();
+
+// Register with ImDrawList::AddCallback() to switch which sampler (bilinear vs. nearest/point) bind
+// group 0 uses for subsequent draw commands in the same render pass - e.g. wrap an ImGui::Image() call
+// that should render with nearest-neighbour filtering (pixel art, tile/sprite previews) with
+// SetSamplerNearest before it and SetSamplerLinear right after, since the bound group is sticky and
+// otherwise leaks into whatever UI renders next.
+//
+// NOTE: this is a local patch, not upstream Dear ImGui. It mirrors the DrawCallback_SetSamplerLinear/
+// DrawCallback_SetSamplerNearest mechanism that landed upstream in v1.92.7 (ocornut/imgui#9378), which
+// isn't reachable yet for the same wgpu-native header reason as IMGUI_IMPL_WGPU_HAS_INVALIDATE_IMAGE_BIND_GROUPS
+// above. Once that's upgraded, drop this patch and switch callers to
+// ImGui::GetPlatformIO().DrawCallback_SetSamplerLinear/Nearest instead - the call sites should translate
+// close to 1:1 since this was written to match upstream's eventual shape.
+//
+// This header is a local, uncommitted patch (the committed imgui submodule pointer doesn't have it) -
+// callers must guard use of these functions behind #ifdef IMGUI_IMPL_WGPU_HAS_SAMPLER_SWITCH so
+// committed code still compiles against the real, unpatched submodule (CI, fresh clones).
+#define IMGUI_IMPL_WGPU_HAS_SAMPLER_SWITCH 1
+IMGUI_IMPL_API void ImGui_ImplWGPU_DrawCallback_SetSamplerLinear(const ImDrawList* parent_list, const ImDrawCmd* cmd);
+IMGUI_IMPL_API void ImGui_ImplWGPU_DrawCallback_SetSamplerNearest(const ImDrawList* parent_list, const ImDrawCmd* cmd);
