@@ -775,6 +775,28 @@ void ImGui_ImplWGPU_InvalidateDeviceObjects()
         SafeRelease(bd->pFrameResources[i]);
 }
 
+void ImGui_ImplWGPU_InvalidateImageBindGroups()
+{
+    ImGui_ImplWGPU_Data* bd = ImGui_ImplWGPU_GetBackendData();
+    if (!bd)
+        return;
+
+    for (int i = 0; i < bd->renderResources.ImageBindGroups.Data.Size; i++)
+    {
+        WGPUBindGroup bind_group = (WGPUBindGroup)bd->renderResources.ImageBindGroups.Data[i].val_p;
+        if (bind_group)
+            wgpuBindGroupRelease(bind_group);
+    }
+    bd->renderResources.ImageBindGroups.Clear();
+
+    // The font atlas' own bind group lives in this same cache (see ImGui_ImplWGPU_CreateDeviceObjects),
+    // aliased into this separate field too - already released above, so it must be nulled out here
+    // as well or SafeRelease(RenderResources&) double-releases it at shutdown. ImGui_ImplWGPU_RenderDrawData
+    // lazily recreates whatever it needs on the next frame it draws that texture, at a negligible
+    // one-time cost.
+    bd->renderResources.ImageBindGroup = nullptr;
+}
